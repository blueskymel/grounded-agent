{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "azureOpenAiEndpoint": {
      "value": "${AZURE_OPENAI_ENDPOINT}"
    },
    "azureOpenAiApiKey": {
      "value": "${AZURE_OPENAI_API_KEY}"
    },
    "azureOpenAiChatDeployment": {
      "value": "${AZURE_OPENAI_CHAT_DEPLOYMENT}"
    },
    "azureOpenAiEmbeddingsDeployment": {
      "value": "${AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT}"
    },
    "azureSearchEndpoint": {
      "value": "${AZURE_SEARCH_ENDPOINT}"
    },
    "azureSearchApiKey": {
      "value": "${AZURE_SEARCH_API_KEY}"
    },
    "azureSearchIndexName": {
      "value": "${AZURE_SEARCH_INDEX_NAME}"
    },
    "appInsightsConnectionString": {
      "value": "${APPLICATIONINSIGHTS_CONNECTION_STRING}"
    },
    "deployKeyVault": {
      "value": "${DEPLOY_KEY_VAULT}"
    },
    "azureOpenAiApiKeySecretName": {
      "value": "${KEYVAULT_AZURE_OPENAI_API_KEY_SECRET_NAME}"
    },
    "azureSearchApiKeySecretName": {
      "value": "${KEYVAULT_AZURE_SEARCH_API_KEY_SECRET_NAME}"
    },
    "appInsightsConnectionStringSecretName": {
      "value": "${KEYVAULT_APPLICATIONINSIGHTS_CONNECTION_STRING_SECRET_NAME}"
    },
    "deployApim": {
      "value": "${DEPLOY_APIM}"
    },
    "publisherEmail": {
      "value": "${APIM_PUBLISHER_EMAIL}"
    },
    "publisherName": {
      "value": "${APIM_PUBLISHER_NAME}"
    }
  }
}
